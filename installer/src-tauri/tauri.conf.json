{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Driver Updater Setup",
    "version": "1.1.2",
    "identifier": "com.github.kirillgrachev.driverupdater.setup",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "setup",
                "title": "Driver Updater Setup",
                "width": 980,
                "height": 800,
                "minWidth": 880,
                "minHeight": 640,
                "resizable": false,
                "maximizable": true,
                "decorations": false,
                "transparent": false,
                "shadow": false,
                "center": true,
                "visible": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
        "resources": ["payload/*"]
    }
}
