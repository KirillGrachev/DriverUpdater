{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driver Updater",
  "version": "1.0.0",
  "identifier": "dev.driverupdater.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Driver Updater",
        "width": 1240,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Free open-source driver manager",
    "longDescription": "Driver Updater is a free open-source manager that keeps the drivers on your computer up to date."
  }
}
