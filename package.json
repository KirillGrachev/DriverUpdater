{
    "name": "driver-updater",
    "private": true,
    "version": "1.1.0",
    "description": "Driver Updater is a free open-source driver manager for Windows (Tauri + React)",
    "author": "Kirill Grachev (https://github.com/KirillGrachev)",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json",
        "tauri": "tauri",
        "check:locales": "node scripts/check-locales.mjs",
        "lint": "eslint src"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.5.0",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.5.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "flag-icons": "^7.6.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1"
        }
    }
}
